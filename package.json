{
  "name": "prntez",
  "version": "2.0.0",
  "description": "Printez Real-Time Document Printing & Counter POS Platform",
  "main": "server/index.js",
  "scripts": {
    "install-all": "npm --prefix client install && npm --prefix server install",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "keywords": [
    "printing",
    "real-time",
    "pos",
    "qr-code",
    "socket.io",
    "express",
    "react"
  ],
  "author": "Printez Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
