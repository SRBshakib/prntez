# Printez Production Environment Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=prntez

# Security & CORS (Set your production domain, e.g. https://prntez.com)
APP_URL=https://prntez.com
ADMIN_PASSWORD=your_strong_admin_password_here
